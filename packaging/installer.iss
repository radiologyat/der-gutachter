; Der Gutachter - Windows installer (Inno Setup 6).
; Per-user install: no admin rights, no internet, nothing outside the user profile.
; Build (CI): iscc /DAppVersion=0.1.0 packaging\installer.iss
; Patient data and models live in %LOCALAPPDATA%\DerGutachter and are KEPT on uninstall.

#ifndef AppVersion
  #define AppVersion "0.0.0-dev"
#endif

[Setup]
AppId={{6F1C2B9E-4D3A-4B8E-9C61-2A7E5D0F3B14}
AppName=Der Gutachter
AppVersion={#AppVersion}
AppPublisher=Der Gutachter
DefaultDirName={localappdata}\Programs\DerGutachter
DisableDirPage=yes
DisableProgramGroupPage=yes
PrivilegesRequired=lowest
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
MinVersion=10.0.19041
OutputDir=..\dist-installer
OutputBaseFilename=DerGutachter-Setup-{#AppVersion}
Compression=lzma2/max
SolidCompression=yes
WizardStyle=modern
SetupIconFile=icon\gutachter.ico
; Disclaimer + licence must be accepted ("Ich akzeptiere") before installing.
; Generated by packaging/make_installer_texts.py from DISCLAIMER.md.
LicenseFile=..\build\installer-license.txt
UninstallDisplayIcon={app}\DerGutachter.exe
CloseApplications=yes
#ifdef SIGN
; Signs the uninstaller too (CI passes /Ssigntool=... when the secret exists).
SignTool=signtool
SignedUninstaller=yes
#endif

[Languages]
Name: "german"; MessagesFile: "compiler:Languages\German.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"

[Files]
Source: "..\dist\DerGutachter\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
; public certificate + trust script, for whoever wants to verify the publisher
Source: "signing\DerGutachter-Codesigning.cer"; DestDir: "{app}\Zertifikat"
Source: "signing\Zertifikat-vertrauen.ps1"; DestDir: "{app}\Zertifikat"

[Icons]
Name: "{userprograms}\Der Gutachter"; Filename: "{app}\DerGutachter.exe"
Name: "{userdesktop}\Der Gutachter"; Filename: "{app}\DerGutachter.exe"; Tasks: desktopicon

[Run]
Filename: "{app}\DerGutachter.exe"; Description: "{cm:LaunchProgram,Der Gutachter}"; Flags: nowait postinstall skipifsilent

[InstallDelete]
; old runtime builds from a previous version
Type: filesandordirs; Name: "{app}\bin"
Type: filesandordirs; Name: "{app}\_internal"
